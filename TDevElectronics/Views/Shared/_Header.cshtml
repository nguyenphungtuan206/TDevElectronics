<header class="hd">
    <div class="wrap r1">
        <!-- Logo -->
        <a class="lg" asp-controller="Home" asp-action="Index"><b>T</b>TDev</a>

        <!-- Main Navigation -->
        <nav>
            <a asp-controller="Shop" asp-action="Index">Products</a>
            <div class="dd">
                <a asp-controller="Shop" asp-action="Index">Categories</a>
                <div class="ddm">
                    <a asp-controller="Shop" asp-action="Index" asp-route-category="Phones">Phones</a>
                    <a asp-controller="Shop" asp-action="Index" asp-route-category="Laptops">Laptops</a>
                    <a asp-controller="Shop" asp-action="Index" asp-route-category="Audio">Audio</a>
                    <a asp-controller="Shop" asp-action="Index" asp-route-category="Office-Furniture">Office Furniture</a>
                    <a asp-controller="Shop" asp-action="Index" asp-route-category="Printers">Printers</a>
                    <a asp-controller="Shop" asp-action="Index" asp-route-category="Accessories">Accessories</a>
                </div>
            </div>
            <a asp-controller="Home" asp-action="BusinessBuying">Request a Quote</a>
            <a asp-controller="Home" asp-action="About">About Us</a>
            <a asp-controller="Home" asp-action="Support">Support</a>
        </nav>

        <!-- Search Form -->
        <div class="sf" id="sf">
            <button class="ib2 sbtn" type="button" aria-label="Search">
                <svg class="i"><use href="#i-search" /></svg>
            </button>
            <input id="hs" placeholder="Search products" aria-label="Search products">
        </div>

        <!-- Cụm chuyển đổi Ngôn ngữ / Tiền tệ (nếu template có) -->
        <div class="lang-curr" id="lang-curr"></div>

        <!-- Action Icons (Theme, Wishlist, Account, Cart) -->
        <span class="ico">
            <a class="ib2" id="wlb" asp-controller="Account" asp-action="Index" data-view="wishlist" aria-label="Wishlist">
                <svg class="i"><use href="#i-heart" /></svg>
                <em class="wc"></em>
            </a>

            <!-- Nút bật/tắt Theme Sáng/Tối -->
            <button class="ib2 tt" type="button" aria-label="Switch light / dark theme" title="Light / dark">
                <svg class="moon" viewBox="0 0 24 24"><path d="M21 12.8A9 9 0 1111.2 3a7 7 0 009.8 9.8z" /></svg>
                <svg class="sun" viewBox="0 0 24 24"><circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" /></svg>
            </button>

            <!-- Container Account / User Info -->
            <span id="user-slot">
                <a class="ib2" asp-controller="Account" asp-action="Login" aria-label="Account">
                    <svg class="i"><use href="#i-user" /></svg>
                </a>
            </span>

            <!-- Giỏ hàng -->
            <a asp-controller="Cart" asp-action="Index" class="ib2 cb" aria-label="Cart">
                <svg class="i"><use href="#i-cart" /></svg>
                <em>0</em>
            </a>
        </span>
    </div>
</header>