@model TDevElectronics.Models.ViewModels.ShopViewModel

@{
    ViewData["Title"] = "Shop";
    ViewBag.Page = "shop";
}

<section class="pg shop-page">

    <p class="cr m">
        Home / Shop / All electronics
    </p>

    <div class="ban">
        <div>
            <h1>Find your next upgrade</h1>
            <p class="m">
                Carefully chosen devices.
                A better everyday starts here.
            </p>
        </div>
    </div>

    <div class="lay">

        <partial name="_FilterPanel" model="Model" />

        <div>
            <div class="hx">
                <span class="m">
                    Showing @Model.TotalResults products
                </span>
            </div>

            <div class="g3">

                @foreach (var item in Model.Items)
                {
                    <partial name="_ProductCard" model="item" />
                }

            </div>
        </div>

    </div>

</section>

@section Styles {
    <link rel="stylesheet"
          href="~/css/shop.css"
          asp-append-version="true" />
}

@section Scripts {
    <script src="~/js/shop.js"
            asp-append-version="true"></script>
}