@{
    ViewData["Title"] = "Privacy Policy";
}

<section class="pg" id="privacy">
    <p class="cr m"><a asp-controller="Home" asp-action="Index">Home</a> &nbsp;/&nbsp; Privacy Policy</p>
    <h1>Privacy Policy</h1>
    <p class="m">How TDev collects and uses your information.</p>
    
    <div class="g3">
        <div class="cd">
            <h3>What we collect</h3>
            <p class="m">Account details, delivery addresses, order and quote history that you provide when you use the store.</p>
        </div>
        <div class="cd">
            <h3>How we use it</h3>
            <p class="m">To process orders, prepare quotes, provide support and send updates you opted in to.</p>
        </div>
        <div class="cd">
            <h3>Your choices</h3>
            <p class="m">You can update your profile, unsubscribe from promotions or ask us to delete your account at <a href="mailto:support@tdev.com">support@tdev.com</a>.</p>
        </div>
    </div>
</section>