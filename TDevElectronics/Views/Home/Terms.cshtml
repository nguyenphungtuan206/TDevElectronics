@{
    ViewData["Title"] = "Terms of Service";
}

<section class="pg" id="terms">
    <p class="cr m"><a asp-controller="Home" asp-action="Index">Home</a> &nbsp;/&nbsp; Terms of Service</p>
    <h1>Terms of Service</h1>
    <p class="m">The basics of buying from TDev.</p>
    
    <div class="g3">
        <div class="cd">
            <h3>Orders &amp; pricing</h3>
            <p class="m">Prices are shown before tax. Business pricing applies to the quantities listed on each product or in an accepted quote.</p>
        </div>
        <div class="cd">
            <h3>Quotes</h3>
            <p class="m">A quote is valid until the date shown on it. Accepting a quote creates a binding order.</p>
        </div>
        <div class="cd">
            <h3>Returns &amp; warranty</h3>
            <p class="m">30-day returns on unused items. Devices carry the manufacturer warranty.</p>
        </div>
    </div>
</section>