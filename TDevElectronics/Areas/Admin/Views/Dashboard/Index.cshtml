@{
    ViewData["Title"] = "Bảng điều khiển";
}

<div class="dash-head" style="margin-bottom: 24px;">
    <h1>Dashboard</h1>
    <p class="m">Tổng quan tình hình kinh doanh và hoạt động của hệ thống.</p>
</div>

<!-- 4 Thẻ chỉ số chính: Doanh thu, Đơn chờ, Báo giá, Sắp hết hàng -->
<div class="g4" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 16px; margin-bottom: 28px;">
    <div class="box" style="padding: 18px; border: 1px solid var(--bd); border-radius: 8px;">
        <small class="m">DOANH THU THỰC TẾ</small>
        <h2 style="margin: 8px 0; color: #10b981;">0 ₫</h2>
        <small class="m">Loại trừ các đơn đã hủy</small>
    </div>
    <div class="box" style="padding: 18px; border: 1px solid var(--bd); border-radius: 8px;">
        <small class="m">ĐƠN CHỜ XỬ LÝ</small>
        <h2 style="margin: 8px 0;">0</h2>
        <small class="m">Cần xác nhận sớm</small>
    </div>
    <div class="box" style="padding: 18px; border: 1px solid var(--bd); border-radius: 8px;">
        <small class="m">YÊU CẦU BÁO GIÁ MỚI</small>
        <h2 style="margin: 8px 0;">0</h2>
        <small class="m">Từ khách hàng doanh nghiệp</small>
    </div>
    <div class="box" style="padding: 18px; border: 1px solid var(--bd); border-radius: 8px;">
        <small class="m">SẢN PHẨM SẮP HẾT HÀNG</small>
        <h2 style="margin: 8px 0; color: #f59e0b;">0</h2>
        <small class="m">Tồn kho &lt; 5 chiếc</small>
    </div>
</div>